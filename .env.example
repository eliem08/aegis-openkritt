# aegis — local configuration TEMPLATE.
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is git-ignored; this template is committed. Never put real secrets here.

# ── HackerOne Hacker API (read-only program discovery) ────────────────────
# API token: https://hackerone.com/settings/api_token/edit  (your handle + token)
HACKERONE_API_USERNAME=your-hackerone-handle
HACKERONE_API_TOKEN=your-hackerone-api-token

# ── Control-plane API (aegis.api) ─────────────────────────────────────────
# Callers of the control plane. Simple form (single-tenant compat, dev only):
#   {api_token: "operator"|"agent"}
# Multi-tenant form (production): give each token a tenant. The engagement's
# tenant is its authorization customer_id; cross-tenant access is denied.
#   {"tok":{"role":"operator","tenant":"tenant-a","name":"opA"}}
# "system-admin" is an operational role that CANNOT execute scans.
AEGIS_API_KEYS={"replace-with-operator-token":"operator","replace-with-agent-token":"agent"}
# Keys used to sign/verify authorization objects, as JSON {key_id: secret}.
# Generate a strong secret, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AEGIS_SIGNING_KEYS={"kid-1":"replace-with-a-long-random-secret"}
# PREFERRED: Ed25519 PUBLIC keys (hex), as JSON {key_id: pubkey_hex}. The control
# plane signs with the matching private key (kept elsewhere); this process only
# verifies. Generate: python -c "from aegis.policy import Ed25519Signer as S; s=S.generate('kid-1'); print(s.public_key_hex()); print(s.private_key_hex())"
# AEGIS_ED25519_PUBLIC_KEYS={"kid-1":"<public-key-hex>"}
# Fail closed by default (signatures required, auth on). Change only if you know why.
AEGIS_REQUIRE_SIGNATURE=1
# AEGIS_AUTH_DISABLED=0
# AEGIS_HOST=127.0.0.1
# AEGIS_PORT=8000
# Durable persistence. Unset = in-memory (lost on restart).
#   SQLite (single node):  AEGIS_DB_PATH=aegis.db
#   Postgres (HA; wins if both set):  AEGIS_DB_URL=postgresql://aegis:aegis@localhost:5432/aegis
# AEGIS_DB_PATH=aegis.db
# AEGIS_DB_URL=postgresql://aegis:aegis@localhost:5432/aegis
# Encryption at rest for the audit trail + authorization (Fernet key).
# Generate:  python -c "from aegis.api.crypto import generate_key; print(generate_key())"
# AEGIS_ENCRYPTION_KEY=

# ── DeepSeek (LLM planner — used as a guardrailed planner, never trusted) ──
# OPTIONAL. Aegis's planner (aegis.ai) proposes a plan that the deterministic
# policy gate then filters — the LLM is never the source of truth. With no key,
# planning falls back to the deterministic planner, so this can stay blank.
# API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CONNECT_TIMEOUT=10
# DEEPSEEK_READ_TIMEOUT=60
# DEEPSEEK_MAX_TOKENS=4096
# Thinking is enabled by default for V4; allowed efforts: low, high, max.
# DEEPSEEK_THINKING=enabled
# DEEPSEEK_REASONING_EFFORT=high

# ── OpenRouter (alternate/fallback LLM provider — OpenAI-compatible) ───────
# OPTIONAL. Lets the 24/7 hunt keep running on your OpenRouter credits. DeepSeek
# stays PRIMARY: if DEEPSEEK_API_KEY is set it is used, and OpenRouter is the
# fallback when DeepSeek has no key. To FORCE OpenRouter for everything, set
# AEGIS_LLM_PROVIDER=openrouter. Get a key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=deepseek/deepseek-chat          # any OpenRouter model slug
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AEGIS_LLM_PROVIDER=deepseek                       # deepseek (default) | openrouter
# Two-model split: run the final validator on a different provider/model than the
# generator (e.g. generate on DeepSeek, validate on OpenRouter, or vice-versa).
# AEGIS_VALIDATOR_MODEL=deepseek/deepseek-chat
# AEGIS_VALIDATOR_BASE_URL=https://openrouter.ai/api/v1
# AEGIS_VALIDATOR_API_KEY=your-openrouter-key

# ── Installed skills (arm's-length; prompt-only runner) ───────────────────
# Clone the 32-skill catalog:  python scripts/install_skills.py   (clones only, runs
# nothing). The runner READS a skill's instructions and applies them via DeepSeek — it
# NEVER executes a skill's own scripts. Scan a skill (NMitchem/SkillScan) before trusting.
# AEGIS_SKILLS_DIR=~/.aegis/skills
# AEGIS_SKILL_CMD='"/abs/path/to/.venv/Scripts/python.exe" -m aegis.ai.skill_runner --skill {source} --target {target}'
# AEGIS_SKILL_MAX=3            # cap skills run per target (0 = no cap; 25+ would explode cost)

# ── Contract lane + retrieval corpus ──────────────────────────────────────
# Prime the smart-contract generator with the 866-finding class distribution.
AEGIS_KNOWLEDGE_CORPUS=reports/contract_corpus_0xsimao.jsonl
# Etherscan verified-source pull for on-chain contract addresses (free tier ok).
# Key: https://etherscan.io/myapikey  — used only to READ public verified source.
# ETHERSCAN_API_KEY=your-etherscan-key

# ── open·kritt bridge (aegis.integrations.OpenKrittClient) ────────────────
# OPTIONAL. Base URL of a running open·kritt backend; when set, the review
# console (GET /ui) can pull that backend's findings into Aegis candidates.
# open·kritt is a SEPARATE AGPL-3.0 service and uses its OWN model access
# (e.g. your Claude login via `./kritt setup`) — no model key belongs here.
# Local default backend port is 3002. Unset = "no backend connected".
# AEGIS_OPENKRITT_URL=http://127.0.0.1:3002
# Bearer token, only if your open·kritt backend requires one (local usually not):
# AEGIS_OPENKRITT_API_KEY=

# ── Learning loop (aegis.learn) ───────────────────────────────────────────
# OPTIONAL. Where human verdicts on findings are stored. Those verdicts calibrate
# candidate ranking and feed the planner few-shot examples (no model retraining).
# Unset = in-memory (resets on restart); set a file path to persist what's learned.
# AEGIS_LEARN_DB=aegis-learn.db

# ── Automatic hunter (python -m aegis.hunt) ───────────────────────────────
# Runs discover -> scan -> collect -> learn on a loop. NEVER exploits or submits;
# only scans authorized, automation-permitted, in-scope CODE repos. Dry-run (plans
# only) unless ARMED. Needs AEGIS_OPENKRITT_URL + HackerOne creds above.
# AEGIS_HUNT_ARM=1                 # arm it: actually launch scans (default: dry-run)
# AEGIS_HUNT_MODEL=<claude-model>  # required to launch
# AEGIS_HUNT_HANDLES=prog-a,prog-b # limit to these programs (default: all authorized)
# AEGIS_HUNT_INTERVAL=3600         # seconds between cycles
# AEGIS_HUNT_MAX_PROGRAMS=3        # per-cycle program cap
# AEGIS_HUNT_MAX_REPOS=3           # per-program repo cap
# AEGIS_HUNT_CYCLES=1              # stop after N cycles (default: run until stopped)
