# Aegis FULL-ARSENAL image — every scanner + language runtime, on Linux where they all work.
#
# The Windows dev box can't run a PHP runtime or semgrep-core reliably; this container is the
# reproducible env where the WHOLE deterministic arsenal runs: semgrep (with the bundled
# offline rules), PHP+psalm, Ruby+brakeman, Go+gosec+osv-scanner, node+retire.js, plus the
# Python scanners. (The lean control-plane image is the default ./Dockerfile.)
#
#   docker build -f Dockerfile.arsenal -t aegis-arsenal .
#   docker run --rm -it --env-file .env -p 8000:8000 aegis-arsenal      # dashboard :8000
#   docker run --rm --env-file .env aegis-arsenal \
#       python -m aegis.ai.hunt_repo owner/repo --files 12 --samples 3
#
FROM python:3.12-slim-bookworm@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579

ARG SEMGREP_VERSION=1.172.0
ARG BANDIT_VERSION=1.9.4
ARG NJSSCAN_VERSION=0.4.3
ARG SLITHER_VERSION=0.11.6
ARG DETECT_SECRETS_VERSION=1.5.0
ARG CHECKOV_VERSION=3.3.9
ARG MYTHRIL_VERSION=0.24.8
ARG BRAKEMAN_VERSION=7.1.1
ARG PSALM_VERSION=6.16.1
ARG RETIRE_VERSION=5.4.3
ARG GOSEC_VERSION=v2.22.8
ARG OSV_SCANNER_VERSION=2.5.1
ARG TRIVY_VERSION=0.73.0
ARG GRYPE_VERSION=0.116.1
ARG GITLEAKS_VERSION=8.21.2
ARG RETIRE_REPOSITORY_COMMIT=7ddda6314785f7e4dbca442296aa399520e13c13

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AEGIS_HOST=0.0.0.0 \
    AEGIS_PORT=8000 \
    AEGIS_SCANNER_HOME=/root \
    GRYPE_DB_AUTO_UPDATE=false \
    GRYPE_CHECK_FOR_APP_UPDATE=false \
    PATH="/root/.composer/vendor/bin:/root/go/bin:/usr/local/go/bin:${PATH}" \
    AEGIS_SKILLS_DIR=/root/.aegis/skills \
    AEGIS_SKILL_CMD="{python} -m aegis.ai.skill_runner --skill {source} --target {target}" \
    # Auto-start the hunt on boot: launching the container becomes the whole pipeline
    # (rank -> hunt -> dashboard). Operator just watches /ui and submits. Tunables:
    # AEGIS_AUTOSTART_RANKING (a targets json; else yield-ranked registry),
    # AEGIS_AUTOSTART_TARGETS (top-N, default 8), AEGIS_AUTOSTART_SAMPLES (default 2),
    # AEGIS_AUTOSTART_IMPORT=1 (refresh feeds first), AEGIS_AUTOSTART_ONCE=1 (no 24/7 loop).
    AEGIS_AUTOSTART=1 \
    AEGIS_AUTOSTART_RANKING=/app/reports/mattermost_targets.json \
    # program radar on boot: diff public feeds vs the registry so paused programs are skipped
    # (no wasted compute) and new ones are caught. Alerts show in the dashboard 'Program radar'.
    AEGIS_AUTOSTART_MONITOR=1 \
    # backfill real repo ages from GitHub on boot (needs GITHUB_TOKEN in --env-file) so the
    # maturity discount down-ranks ancient/picked-over repos and floats fresh targets.
    AEGIS_AUTOSTART_GITHUB_AGE=1 \
    # analyse files concurrently — LLM calls are I/O-bound, so a bounded pool is a near-linear
    # speedup. 6 is a safe default vs provider rate limits; raise/lower per your model tier.
    AEGIS_CONCURRENCY=6 \
    # global cap on total in-flight LLM calls (files x samples both submit through it), so the
    # two concurrency layers can't multiply past the provider rate limit. Tune to your tier.
    AEGIS_LLM_CONCURRENCY=8 \
    # 24/7 carpet sweep on boot: fast deterministic detectors over every in-scope source repo,
    # forever, skipping unchanged repos. The always-on cheap hunter. Tunables: AEGIS_CARPET_*
    # (INTERVAL sec, CONCURRENCY, IMPORT_EVERY cycles). Hits show in the dashboard 'Carpet sweep'.
    AEGIS_AUTOSTART_CARPET=1 \
    AEGIS_CARPET_CONCURRENCY=4 \
    AEGIS_CARPET_INTERVAL=1800

# --- OS packages: language runtimes for the language-specific scanners ---
RUN apt-get update && apt-get install -y --no-install-recommends \
      git curl ca-certificates unzip xz-utils \
      php-cli php-xml php-mbstring composer \
      ruby-full ruby-dev build-essential \
      nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# --- Modern Go (Debian's 1.19 is too old). GOTOOLCHAIN=auto (default) lets `go install`
#     fetch the exact newer toolchain a tool pins (e.g. gosec needs go >= 1.25). ---
RUN curl -sfL https://go.dev/dl/go1.22.5.linux-amd64.tar.gz | tar -C /usr/local -xz

# --- Python scanners. Every production binary is version-pinned; build failures are fatal. ---
RUN pip install --upgrade "pip==25.2" "setuptools<81" && \
    pip install \
      "semgrep==${SEMGREP_VERSION}" \
      "bandit==${BANDIT_VERSION}" \
      "slither-analyzer==${SLITHER_VERSION}" \
      "detect-secrets==${DETECT_SECRETS_VERSION}" \
      "checkov==${CHECKOV_VERSION}"
# njsscan pins a different Semgrep release; keep its interpreter and engine isolated.
RUN python -m venv /opt/aegis-tools/njsscan && \
    /opt/aegis-tools/njsscan/bin/pip install "pip==25.2" && \
    /opt/aegis-tools/njsscan/bin/pip install "njsscan==${NJSSCAN_VERSION}" && \
    ln -s /opt/aegis-tools/njsscan/bin/njsscan /usr/local/bin/njsscan
# Mythril has an older dependency surface, so isolate it from the control-plane environment.
RUN python -m venv /opt/aegis-tools/mythril && \
    /opt/aegis-tools/mythril/bin/pip install "pip==25.2" "setuptools<81" && \
    /opt/aegis-tools/mythril/bin/pip install \
      "mythril==${MYTHRIL_VERSION}" "solc-select==1.1.0" && \
    ln -s /opt/aegis-tools/mythril/bin/myth /usr/local/bin/myth
RUN curl -fL \
      "https://github.com/ethereum/solidity/releases/download/v0.8.24/solc-static-linux" \
      -o /usr/local/bin/solc && chmod 0755 /usr/local/bin/solc && \
    solc --version | grep -F "0.8.24"

# --- PHP: Psalm (taint) · Ruby: Brakeman · Node: retire.js ---
# Each install is its OWN layer and non-fatal: a transient network blip on one tool can't
# kill the whole build, and Docker's layer cache re-runs only the tool that failed. The
# self-check at the end reports which of the 14 actually resolved.
ENV COMPOSER_ALLOW_SUPERUSER=1 COMPOSER_PROCESS_TIMEOUT=900
# Psalm + WordPress stubs so taint analysis resolves wp_*/$wpdb and traces through them
# (psalm on a WP plugin is near-blind without these). AEGIS_PHP_STUBS is injected into the
# psalm command when the file exists.
RUN composer global require --no-interaction \
      "vimeo/psalm:${PSALM_VERSION}" "php-stubs/wordpress-stubs:^6.7"
ENV AEGIS_PHP_STUBS=/root/.composer/vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
RUN gem install --no-document brakeman -v "${BRAKEMAN_VERSION}"
RUN npm install -g "retire@${RETIRE_VERSION}"
RUN mkdir -p /opt/aegis-data/retire && curl -fL \
      "https://raw.githubusercontent.com/RetireJS/retire.js/${RETIRE_REPOSITORY_COMMIT}/repository/jsrepository.json" \
      -o /opt/aegis-data/retire/jsrepository.json

# --- Go-based scanners: gosec + osv-scanner via modern Go's go install ---
RUN go install "github.com/securego/gosec/v2/cmd/gosec@${GOSEC_VERSION}"
RUN curl -fL \
      "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64" \
      -o /usr/local/bin/osv-scanner && chmod 0755 /usr/local/bin/osv-scanner
RUN mkdir -p /root/.cache/osv-scalibr/npm && curl -fL \
      "https://osv-vulnerabilities.storage.googleapis.com/npm/all.zip" \
      -o /root/.cache/osv-scalibr/npm/all.zip

# --- Prebuilt-binary scanners: trivy, grype, gitleaks (to /usr/local/bin) ---
RUN curl -sfL \
      "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
      | tar -xz -C /usr/local/bin trivy
RUN curl -sfL \
      "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz" \
      | tar -xz -C /usr/local/bin grype
RUN curl -sfL \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
      | tar -xz -C /usr/local/bin gitleaks

# Dependency databases are baked into the image so fixture runs can use --network none.
RUN trivy image --download-db-only --no-progress
RUN grype db update

# --- Strix (usestrix/strix) — arm's-length autonomous AI pentester, Apache-2.0.
#     Invoked opt-in (AEGIS_ALLOW_STRIX=1) on local source; drives its own LLM (point
#     STRIX_LLM/LLM_API_KEY at your model). Installed here so the bin resolves. ---
# --- Aegis itself (editable) ---
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install -e ".[api,postgres]"
COPY . .

# clone the arm's-length skill catalog so the prompt-only runner can read their instructions
# (never executes a skill's own scripts — only reads SKILL.md and runs it via DeepSeek)
# NOTE: these are read ARM'S-LENGTH — the prompt-only skill_runner reads a skill's SKILL.md
# and runs it via the LLM over LOCAL source; it never executes a skill's own scripts, never
# copies their text into Aegis, and never performs the live-target actions some describe.
# Gabson0x/bountyforge is unlicensed, so it is invoke-only here (read, never vendored).
# Fail packaging if a required scanner is absent. This is not execution credit: only the
# signed fixture path can produce an EXECUTED_* coverage record.
RUN python -c "from aegis.ai.tool_registry import TOOLS; from aegis.ai.tool_bridge import available_tools; \
expected={t.name for t in TOOLS}; actual={t.name for t in available_tools()}; \
assert expected == actual, f'missing packaged scanners: {sorted(expected-actual)}'; \
print('PACKAGED SCANNERS:', sorted(actual))"

EXPOSE 8000
CMD ["python", "-m", "aegis.api"]
