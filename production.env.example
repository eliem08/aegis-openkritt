# Copy to secrets/production.env and replace every required image with a real,
# reviewed digest. The bootstrap command never invents third-party release pins.
AEGIS_PYTHON_IMAGE=python:3.12-slim@sha256:REPLACE_WITH_64_HEX_DIGEST
AEGIS_POSTGRES_IMAGE=postgres:16-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
AEGIS_REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_WITH_64_HEX_DIGEST
AEGIS_BROWSER_IMAGE=mcr.microsoft.com/playwright/python:v1.54.0-noble@sha256:REPLACE_WITH_64_HEX_DIGEST
AEGIS_OAST_DOMAIN=oast.example.org
AEGIS_CONTROL_PORT=8000
AEGIS_COORD_NAMESPACE=aegis-prod
